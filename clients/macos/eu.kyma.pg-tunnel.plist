<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The laptop's tunnel to the prod database (openai-ads-api/docs/2026-10-26_prod-database-plan.md,
     step 4): localhost:5433 is the server's Postgres socket, reached as Unix user deploy, so Postgres
     sees deploy (peer auth: kyma_ingest writes, reader_deploy reads, no password).
     localhost:5432 stays the local test container.
     Install: cp to ~/Library/LaunchAgents/, then
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/eu.kyma.pg-tunnel.plist
     launchd restarts ssh whenever it exits (network change, sleep, server reboot). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>eu.kyma.pg-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-N</string>
        <string>-o</string><string>BatchMode=yes</string>
        <string>-o</string><string>ExitOnForwardFailure=yes</string>
        <string>-o</string><string>ServerAliveInterval=30</string>
        <string>-o</string><string>ServerAliveCountMax=3</string>
        <string>-L</string><string>127.0.0.1:5433:/var/run/postgresql/.s.PGSQL.5432</string>
        <string>deploy@46.224.142.195</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardErrorPath</key>
    <string>/Users/nico/Library/Logs/kyma-pg-tunnel.log</string>
</dict>
</plist>
